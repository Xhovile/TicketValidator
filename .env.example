# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# BuyMesho handoff endpoints for Ticket Validator.
# Ticket Validator sends unauthenticated users to the canonical BuyMesho login.
VITE_BUYMESHO_LOGIN_URL="https://buymesho.app/login"
VITE_BUYMESHO_SIGNUP_URL="https://buymesho.app/signup"
VITE_BUYMESHO_API_BASE_URL="https://buymesho.onrender.com"

# BuyMesho ticket credential verification. Public key only; never configure the BuyMesho private signing key here.
VITE_BUYMESHO_TICKET_SIGNING_KEY_ID="buymesho-ticket-2026"
VITE_BUYMESHO_TICKET_PUBLIC_KEY=""
